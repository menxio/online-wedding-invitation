# Browser-safe Supabase configuration used by admin authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only elevated key (sb_secret_...). Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only HMAC secret for privacy-conscious rate-limit keys.
RSVP_RATE_LIMIT_PEPPER=

# Cloudflare Turnstile. The site key is public; the secret remains server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
